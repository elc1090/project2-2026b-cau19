# Copie este arquivo para ".env" (mesma pasta) e preencha com as chaves do
# seu projeto no Supabase: Project Settings > API (ou "Data API" / "API Keys").
# NUNCA coloque essas chaves diretamente no codigo nem no README.

# Project URL (ex: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# Chave publica "anon" / "public" (as vezes chamada de "publishable key").
# NAO use a chave "service_role" / "secret" aqui.
SUPABASE_KEY=
